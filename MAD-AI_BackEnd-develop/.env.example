# Local defaults. Render sets PORT automatically and should use Production.
ASPNETCORE_ENVIRONMENT=Development
PORT=10000
Jwt__Key=replace-with-local-development-jwt-key
Jwt__Issuer=MADAI
Jwt__Audience=MADAIUsers
ConnectionStrings__DefaultConnection=Data Source=MADAI.local.db
Database__ApplyMigrationsOnStartup=false
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=https://your-frontend-domain.example
OpenRouter__ApiKey=replace-with-local-openrouter-key-if-needed
GoogleMaps__ApiKey=replace-with-local-google-maps-key-if-needed

# Explicit provider-off backend demo; absent/false preserves normal behavior.
BackendDemo__Enabled=false
# Seed only in Development via --seed-demo. Set SeedPassword locally using a
# secure prompt/environment; never save it here. Seeding requires an absolute
# ConnectionStrings__DefaultConnection path whose filename is madai.demo.db.
