{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "replace-with-local-development-jwt-key",
    "Issuer": "MADAI",
    "Audience": "MADAIUsers"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=MADAI.local.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://your-frontend-domain.example"
    ]
  },
  "OpenRouter": {
    "ApiKey": "replace-with-local-openrouter-key-if-needed"
  },
  "GoogleMaps": {
    "ApiKey": "replace-with-local-google-maps-key-if-needed"
  }
}
